{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunmedx-funnel-autopilot",
  "main": "worker/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Sunmedx · Funnel Autopilot",
    "APP_URL": "https://sunmedx-funnel-autopilot.workers.dev"
  }
  // Secrets (set in Cloudflare Dashboard -> Settings -> Variables and Secrets,
  // via `npx wrangler secret put GEMINI_API_KEY`, or in local `.dev.vars`):
  //   GEMINI_API_KEY
  //
  // Optional KV binding (Cloudflare Dashboard -> Settings -> Bindings -> KV Namespace):
  // "kv_namespaces": [
  //   { "binding": "SUNMEDX_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  // ]
}
